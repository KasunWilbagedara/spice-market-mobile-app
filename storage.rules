rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read spice images
    match /spices/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny access to everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
