rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated sellers to write to their spice images
    match /spices/{spiceId}/{allPaths=**} {
      allow read: if true;  // Public read
      allow write: if request.auth != null;  // Authenticated write
      allow delete: if request.auth != null;  // Authenticated delete
    }

    // Allow authenticated users to write to temp uploads (for fallback)
    match /temp/{userId}/{allPaths=**} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Allow any authenticated user to write to spice upload paths
    match /spices/{spiceId}/{timestamp} {
      allow write: if request.auth != null;
      allow read: if true;
    }

    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write, delete: if false;
    }
  }
}
